		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "DimIndustry.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
